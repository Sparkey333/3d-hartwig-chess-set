# Server-side Higgsfield credentials (NEVER use VITE_ prefix — SDK is Node-only)
# Format: KEY_ID:KEY_SECRET from https://cloud.higgsfield.ai
HF_CREDENTIALS=

# Or split form:
# HF_API_KEY=
# HF_API_SECRET=

# Optional override (default: https://platform.higgsfield.ai)
# HF_BASE_URL=https://platform.higgsfield.ai

# Legacy client vars kept for docs compatibility — ignored by the proxy
# VITE_HIGGSFIELD_API_KEY=
# VITE_HIGGSFIELD_API_URL=
